# Canonical site URL used in metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.palaniappaelectronics.in

# Enquiry delivery — configure at least one channel.
# 1) Email through Resend (https://resend.com). Verify your sending domain there.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=b2b.palaniappa@gmail.com,enquiry.palaniappa@gmail.com
ENQUIRY_FROM_EMAIL=Palaniappa Website <enquiries@palaniappaelectronics.in>

# 2) Webhook (CRM, Zapier, Make, Google Apps Script…). Receives the enquiry as JSON.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
